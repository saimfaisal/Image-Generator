DATABASE_URL=
DIRECT_URL=

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional shared rate-limit provider. Leave unset for local development;
# production should configure an approved distributed provider before enabling
# expensive AI or upload endpoints.
RATE_LIMIT_PROVIDER=

# Optional password-reset email delivery. Without these, reset requests remain
# generic and no reset email is sent.
RESEND_API_KEY=
EMAIL_FROM=

# Phase 4 image engine. `mock` is development-only and does not call an AI provider.
AI_PROVIDER=google-vertex-ai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-001
GOOGLE_CLOUD_STORAGE_BUCKET=
# Optional output prefix for asynchronous Veo jobs.
GOOGLE_VIDEO_OUTPUT_PREFIX=pixelforge-video-output
# Use exactly one server-side auth mode: ADC, a key file path, or JSON credentials.
GOOGLE_USE_ADC=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
STORAGE_PROVIDER=google-cloud-storage
VIDEO_WORKER_SECRET=
